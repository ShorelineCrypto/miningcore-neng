{
  "logging": {
    "level": "info",
    "enableConsoleLog": true,
    "enableConsoleColors": true,
    "logFile": "core.log",
    "apiLogFile": "api.log",
    "logBaseDirectory": "/app/logs",
    "perPoolLogFile": false
  },
  "banning": {
    "manager": "Integrated",
    "banOnJunkReceive": true,
    "banOnInvalidShares": false
  },
  "notifications": {
    "enabled": false
  },
  "persistence": {
    "postgres": {
      "host": "postgres",
      "port": 5432,
      "user": "miningcore",
      "password": "YOUR_DB_PASSWORD",
      "database": "miningcore"
    }
  },
  "paymentProcessing": {
    "enabled": true,
    "interval": 600,
    "shareRecoveryFile": "recovered-shares.txt"
  },
  "api": {
    "enabled": true,
    "listenAddress": "0.0.0.0",
    "port": 4000,
    "metricsIpWhitelist": [],
    "adminIpWhitelist": []
  },
  "pools": [
    {
      "id": "neng1",
      "enabled": true,
      "coin": "nengcoin",
      "address": "YOUR_NENG_LEGACY_POOL_ADDRESS",
      "rewardRecipients": [
        {
          "address": "YOUR_NENG_LEGACY_FEE_ADDRESS",
          "percentage": 0.5
        }
      ],
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 55,
      "clientConnectionTimeout": 600,
      "banning": {
        "enabled": true,
        "time": 600,
        "invalidPercent": 50,
        "checkThreshold": 50
      },
      "ports": {
        "4032": {
          "listenAddress": "0.0.0.0",
          "name": "CPU / Low-Diff Scrypt",
          "difficulty": 0.001,
          "varDiff": {
            "minDiff": 0.0005,
            "maxDiff": 16,
            "targetTime": 15,
            "retargetTime": 60,
            "variancePercent": 30
          }
        },
        "4033": {
          "listenAddress": "0.0.0.0",
          "name": "GPU / USB ASIC Scrypt",
          "difficulty": 64,
          "varDiff": {
            "minDiff": 8,
            "maxDiff": 4096,
            "targetTime": 15,
            "retargetTime": 60,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "nengcoind",
          "port": 6376,
          "user": "YOUR_RPC_USER",
          "password": "YOUR_RPC_PASSWORD",
          "zmqBlockNotifySocket": "tcp://nengcoind:28332"
        }
      ],
      "paymentProcessing": {
        "enabled": true,
        "minimumPayment": 10,
        "payoutScheme": "PPLNS",
        "payoutSchemeConfig": {
          "factor": 2.0
        }
      }
    }
  ]
}
